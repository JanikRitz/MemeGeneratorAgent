{
  "format": "meme/v1",
  "input": "media/examples/video.mp4",
  "output": "render/examples/video_trim_scale_overlay.mp4",
  "steps": [
    {
      "op": "trim",
      "start": 1,
      "end": 6
    },
    {
      "op": "scale",
      "max_long_side": 640,
      "encode": {
        "crf": 34,
        "preset": "fast",
        "bitrate": "900k",
        "audio_bitrate": "64k"
      }
    },
    {
      "op": "captions",
      "style": "headline",
      "encode": {
        "crf": 36,
        "preset": "fast",
        "bitrate": "900k",
        "audio_bitrate": "64k"
      },
      "items": [
        {
          "text": "**TRIM + SCALE + OVERLAY**",
          "at": "top",
          "end": 5
        },
        {
          "text": "\u003cspan style=\"color:#00ccff\"\u003e\u003ci\u003e640 max-long-side target\u003c/i\u003e\u003c/span\u003e",
          "at": "bottom",
          "start": 2.2,
          "end": 5
        }
      ]
    }
  ]
}
